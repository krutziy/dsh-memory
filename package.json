{
  "name": "dsh-memory",
  "version": "0.5.0",
  "private": true,
  "description": "DSH 长期记忆插件（多 provider）：OpenAI 兼容的云端嵌入 + Qdrant 向量库，自动记录对话要点与图片概览、自动召回，提供 memory_search/save/forget 工具，并在设置页提供 provider 管理、记忆管理与定期维护。",
  "type": "module",
  "main": "index.js",
  "icon": "./icon.svg",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "build.mjs",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md"
  ],
  "dependencies": {
    "@deepseek-ai/schemastery": "~3.18.4"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-general",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs"
  }
}
